<Window x:Class="gyak.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gyak"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="button" Content="Button" HorizontalAlignment="Left" Margin="150,117,0,0" VerticalAlignment="Top" MouseEnter="mozog"/>
        <TabControl x:Name="tabControl">
            <TabItem Header="TabItem">
                <Grid Background="#FFE5E5E5"/>
            </TabItem>
            <TabItem Header="TabItem">
                <Grid Background="#FFE5E5E5">
                    <Label x:Name="label1" HorizontalAlignment="Left" Margin="199,92,0,0" VerticalAlignment="Top">
                        <Label x:Name="label1_Copy3" Content="Label" HorizontalAlignment="Left" VerticalAlignment="Top"/>
           
                    <Label x:Name="label1_Copy" Content="Label" HorizontalAlignment="Left" Margin="315,151,0,0" VerticalAlignment="Top"/>
                    <Label x:Name="label1_Copy1" Content="Label" HorizontalAlignment="Left" Margin="206,0,0,0" VerticalAlignment="Center"/>
                    <Label x:Name="label1_Copy2" Content="Label" HorizontalAlignment="Left" Margin="267,213,0,0" VerticalAlignment="Top"/>
                </Grid>
            </TabItem>
            <Label x:Name="label" Content="Label"/>
        </TabControl>

    </Grid>
</Window>
