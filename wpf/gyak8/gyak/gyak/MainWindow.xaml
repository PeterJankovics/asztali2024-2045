<Window x:Class="gyak.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gyak"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="400">
    <Grid>
        <Label x:Name="label" Content="A" HorizontalAlignment="Left" Margin="76,102,0,0" VerticalAlignment="Top" Width="20"/>
        <Label x:Name="label1" Content="B" HorizontalAlignment="Center" Margin="0,97,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="textBox" HorizontalAlignment="Left" Margin="61,142,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="49" TextChanged="textBox_TextChanged"/>
        <TextBox x:Name="textBox1" HorizontalAlignment="Center" Margin="0,142,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="49"/>
        <Label x:Name="label_Copy" Content="+" HorizontalAlignment="Left" Margin="134,138,0,0" VerticalAlignment="Top" Width="20"/>
        <Label x:Name="label_Copy1" Content="=" HorizontalAlignment="Left" Margin="246,138,0,0" VerticalAlignment="Top" Width="20"/>
        <TextBlock x:Name="textBlock" HorizontalAlignment="Left" Margin="287,144,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top"/>
        <Button x:Name="button" Content="Összead" HorizontalAlignment="Left" Margin="61,182,0,0" VerticalAlignment="Top" Width="232" Height="67" Click="button_Click"/>
        <Label x:Name="label2" Content="A+B" HorizontalAlignment="Left" Margin="268,94,0,0" VerticalAlignment="Top" Height="34" Width="42"/>
        <ListBox x:Name="listBox" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="31,11,213,182" RenderTransformOrigin="0.5,0.5">
            <ListBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0"/>
                    <RotateTransform/>
                    <TranslateTransform X="0"/>
                </TransformGroup>
            </ListBox.RenderTransform>
        </ListBox>

    </Grid>
</Window>
